<mujoco model="arm_scene">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/> 
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    
    <mesh name="banana_mesh" file="../assets/011_banana/textured.obj" scale="1 1 1"/>
    <texture name="banana_tex" type="2d" file="../assets/011_banana/texture_map.png"/>
    <material name="banana_mat" texture="banana_tex" specular="0.5" shininess="0.5"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 .05" type="plane" material="grid" condim="3"/>

    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

  <body name="table" pos="0.5 0 0.3">
    <geom type="box" size="0.3 0.4 0.3" rgba="0.8 0.6 0.4 1" friction="1 0.005 0.0001"/>
  </body>

  <body name="banana" pos="0.5 0 1.0" euler="90 0 0"> 
    <freejoint/> 
    
    <geom type="mesh" mesh="banana_mesh" material="banana_mat" 
          group="1" contype="0" conaffinity="0" density="0"/>
  
    <geom type="capsule" size="0.02 0.08" rgba="1 0 0 0.5" mass="0.1" friction="1 0.005 0.0001"/>
    
  </body>

    </worldbody>
</mujoco>