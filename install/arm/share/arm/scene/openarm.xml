<mujoco model="openarm_v10">
  <compiler angle="radian" meshdir="./"/>
  
  <default>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="1" material="robot_mat"/>
    </default>
    <default class="collision">
      <geom type="mesh" group="3"/>
    </default>
  </default>

  <asset>
    <material name="robot_mat" rgba="0.9 0.9 0.9 1" specular="0.5" shininess="0.25"/>
    <material name="hand_mat" rgba="0.3 0.3 0.3 1"/>

    <mesh name="body_vis" file="http://localhost:8001/body/v10/visual/body_link0.stl"/>
    <mesh name="body_col" file="http://localhost:8001/body/v10/collision/body_link0_symp.stl"/>

    <mesh name="l0_vis" file="http://localhost:8001/arm/v10/visual/link0.stl"/>
    <mesh name="l1_vis" file="http://localhost:8001/arm/v10/visual/link1.stl"/>
    <mesh name="l2_vis" file="http://localhost:8001/arm/v10/visual/link2.stl"/>
    <mesh name="l3_vis" file="http://localhost:8001/arm/v10/visual/link3.stl"/>
    <mesh name="l4_vis" file="http://localhost:8001/arm/v10/visual/link4.stl"/>
    <mesh name="l5_vis" file="http://localhost:8001/arm/v10/visual/link5.stl"/>
    <mesh name="l6_vis" file="http://localhost:8001/arm/v10/visual/link6.stl"/>
    <mesh name="l7_vis" file="http://localhost:8001/arm/v10/visual/link7.stl"/>

    <mesh name="l0_col" file="http://localhost:8001/arm/v10/collision/link0_symp.stl"/>
    <mesh name="l1_col" file="http://localhost:8001/arm/v10/collision/link1_symp.stl"/>
    <mesh name="l2_col" file="http://localhost:8001/arm/v10/collision/link2_symp.stl"/>
    <mesh name="l3_col" file="http://localhost:8001/arm/v10/collision/link3_symp.stl"/>
    <mesh name="l4_col" file="http://localhost:8001/arm/v10/collision/link4_symp.stl"/>
    <mesh name="l5_col" file="http://localhost:8001/arm/v10/collision/link5_symp.stl"/>
    <mesh name="l6_col" file="http://localhost:8001/arm/v10/collision/link6_symp.stl"/>
    <mesh name="l7_col" file="http://localhost:8001/arm/v10/collision/link7_symp.stl"/>

    <mesh name="hand_vis" file="http://localhost:8001/ee/openarm_hand/visual/hand.stl"/>
    <mesh name="hand_col" file="http://localhost:8001/ee/openarm_hand/collision/hand.stl"/>
    <mesh name="finger_vis" file="http://localhost:8001/ee/openarm_hand/visual/finger.stl"/>
    <mesh name="finger_col" file="http://localhost:8001/ee/openarm_hand/collision/finger.stl"/>
  </asset>

  <worldbody>
    <body name="base_link" pos="0 0 0">
      <geom mesh="body_vis" class="visual"/>
      <geom mesh="body_col" class="collision"/>

      <body name="link0" pos="0 0.15 0.1"> <geom mesh="l0_vis" class="visual"/>
         <geom mesh="l0_col" class="collision"/>
         
         <body name="link1" pos="0 0 0.15"> <joint name="joint1" axis="0 0 1" range="-3.14 3.14"/>
            <geom mesh="l1_vis" class="visual"/>
            <geom mesh="l1_col" class="collision"/>

            <body name="link2" pos="0 0.05 0.15"> <joint name="joint2" axis="0 1 0" range="-2.0 2.0"/>
                <geom mesh="l2_vis" class="visual"/>
                <geom mesh="l2_col" class="collision"/>
                
                <body name="link3" pos="0 0 0.2"> <joint name="joint3" axis="0 0 1" range="-3.14 3.14"/>
                    <geom mesh="l3_vis" class="visual"/>
                    <geom mesh="l3_col" class="collision"/>

                    <body name="link4" pos="0 0 0.2"> <joint name="joint4" axis="0 1 0" range="-2.0 2.0"/>
                        <geom mesh="l4_vis" class="visual"/>
                        <geom mesh="l4_col" class="collision"/>

                        <body name="link5" pos="0 0 0.15"> <joint name="joint5" axis="0 0 1" range="-3.14 3.14"/>
                            <geom mesh="l5_vis" class="visual"/>
                            <geom mesh="l5_col" class="collision"/>

                             <body name="link6" pos="0 0 0.1"> <joint name="joint6" axis="0 1 0" range="-2.0 2.0"/>
                                <geom mesh="l6_vis" class="visual"/>
                                <geom mesh="l6_col" class="collision"/>

                                <body name="link7" pos="0 0 0.1">
                                    <joint name="joint7" axis="0 0 1" range="-3.14 3.14"/>
                                    <geom mesh="l7_vis" class="visual"/>
                                    <geom mesh="l7_col" class="collision"/>
                                    
                                    <body name="hand" pos="0 0 0.05">
                                        <geom mesh="hand_vis" class="visual" material="hand_mat"/>
                                        <geom mesh="hand_col" class="collision"/>
                                        </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
         </body>
      </body>
      
    </body>
  </worldbody>
</mujoco>